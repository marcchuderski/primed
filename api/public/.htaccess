# Deployed to httpdocs/api/. Every request is handled by index.php.
Options -Indexes -MultiViews
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /api/

    # Existing files other than the front controller are never served (defense in depth).
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule !^index\.php$ - [F,L]

    RewriteRule ^ index.php [L]
</IfModule>
