# Deployed to httpdocs/api/. Every request is handled by index.php.
Options -Indexes -MultiViews
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /api/

    # Enforce HTTPS here too: this file's rules replace the web root's, so its redirect does not apply.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # Existing files other than the front controller are never served (defense in depth).
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule !^index\.php$ - [F,L]

    RewriteRule ^ index.php [L]
</IfModule>
