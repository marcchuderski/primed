{
    "name": "primed/api",
    "description": "Primed REST API",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "~8.3.0",
        "ext-curl": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-sodium": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.0",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Primed\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Primed\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.3.8"
        },
        "sort-packages": true,
        "allow-plugins": {},
        "optimize-autoloader": true
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs",
        "analyse": "phpstan analyse --memory-limit=512M",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    }
}
