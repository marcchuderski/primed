# Kopie als .env AUSSERHALB des Webroots ablegen (siehe docs/DEPLOYMENT.md). Niemals committen.
APP_ENV=production
APP_URL=https://primed.dev-pfeffermond.de
API_BASE_PATH=/api

DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

SESSION_IDLE_DAYS=30
SESSION_ABSOLUTE_DAYS=90

# Geheimer Anwendungsschlüssel (mind. 32 zufällige Bytes, base64). Daraus werden getrennte Schlüssel für
# IP-HMAC (Login-Schutz) und CSRF-Tokens abgeleitet. Erzeugen: php -r 'echo base64_encode(random_bytes(32)), PHP_EOL;'
# Ein Wechsel macht bestehende CSRF-Tokens ungültig (Seite neu laden genügt).
APP_KEY=

# Zusätzliche erlaubte Origins für schreibende Requests (kommagetrennt). Produktion: leer lassen.
# Lokal z. B. http://localhost:5173 für den Vite-Dev-Server.
ALLOWED_ORIGINS=

# Open Food Facts verlangt einen aussagekräftigen User-Agent mit Kontakt
OFF_USER_AGENT="Primed/0.1"
# Erreichbare Kontaktadresse (Vorgabe von Open Food Facts); echte Adresse nur in der .env
OFF_CONTACT_EMAIL=
